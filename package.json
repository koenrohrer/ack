{
  "name": "ack",
  "displayName": "ACK - Agent Config Keeper",
  "description": "Discover, install, configure, and switch between agent tool sets",
  "version": "1.3.1",
  "publisher": "koenrohrer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koenrohrer/ack"
  },
  "bugs": {
    "url": "https://github.com/koenrohrer/ack/issues"
  },
  "homepage": "https://github.com/koenrohrer/ack#readme",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "agent",
    "tools",
    "skills",
    "profiles",
    "ai"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/ack-logo.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ack",
          "title": "ACK - Agent Config Keeper",
          "icon": "media/icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "ack": [
        {
          "id": "ack.toolTree",
          "name": "Tools",
          "icon": "media/icons/tool-tree.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ack.toolTree",
        "contents": "No agent tools found.\n\nInstall a supported agent (Claude Code or Codex) to get started.\n[Claude Code](https://docs.anthropic.com/en/docs/claude-code) | [Codex](https://openai.com/index/codex/)",
        "when": "ack.noTools"
      }
    ],
    "commands": [
      {
        "command": "ack.testReadAll",
        "title": "ACK: Test Read All Tools"
      },
      {
        "command": "ack.openToolSource",
        "title": "ACK: Open Tool Source"
      },
      {
        "command": "ack.refreshToolTree",
        "title": "ACK: Refresh Tool Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "ack.toggleTool",
        "title": "Toggle Enable/Disable",
        "icon": "$(symbol-boolean)"
      },
      {
        "command": "ack.deleteTool",
        "title": "Delete Tool"
      },
      {
        "command": "ack.moveToolToUser",
        "title": "Global (User)"
      },
      {
        "command": "ack.moveToolToProject",
        "title": "Project"
      },
      {
        "command": "ack.installTool",
        "title": "Install...",
        "icon": "$(add)"
      },
      {
        "command": "ack.createProfile",
        "title": "ACK: Create Profile"
      },
      {
        "command": "ack.switchProfile",
        "title": "ACK: Switch Profile",
        "icon": "$(account)"
      },
      {
        "command": "ack.editProfile",
        "title": "ACK: Edit Profile"
      },
      {
        "command": "ack.deleteProfile",
        "title": "ACK: Delete Profile"
      },
      {
        "command": "ack.saveAsProfile",
        "title": "ACK: Save Current State as Profile"
      },
      {
        "command": "ack.openConfigPanel",
        "title": "ACK: Configure Agent"
      },
      {
        "command": "ack.exportProfile",
        "title": "ACK: Export Profile"
      },
      {
        "command": "ack.importProfile",
        "title": "ACK: Import Profile"
      },
      {
        "command": "ack.associateProfile",
        "title": "ACK: Associate Profile with Workspace"
      },
      {
        "command": "ack.initCodexProject",
        "title": "ACK: Initialize Codex for This Project",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "ack.redetectAgents",
        "title": "ACK: Re-detect Agents"
      },
      {
        "command": "ack.switchAgent",
        "title": "ACK: Switch Agent",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "ack.addMcpServer",
        "title": "Add MCP Server",
        "icon": "$(add)"
      },
      {
        "command": "ack.toggleMcpTool",
        "title": "Toggle Tool",
        "icon": "$(symbol-method)"
      },
      {
        "command": "ack.addEnvVar",
        "title": "Add Environment Variable",
        "icon": "$(add)"
      },
      {
        "command": "ack.editEnvVar",
        "title": "Edit Environment Variable",
        "icon": "$(edit)"
      },
      {
        "command": "ack.revealEnvVar",
        "title": "Copy Value to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "ack.removeEnvVar",
        "title": "Remove Environment Variable",
        "icon": "$(trash)"
      },
      {
        "command": "ack.installPromptFromFile",
        "title": "ACK: Install Custom Prompt from File",
        "icon": "$(file-add)"
      },
      {
        "command": "ack.installInstructionFromFile",
        "title": "ACK: Install Instruction or Prompt from File",
        "icon": "$(file-add)"
      },
      {
        "command": "ack.cloneProfileToAgent",
        "title": "ACK: Clone Profile to Agent"
      },
      {
        "command": "ack.deletePrompt",
        "title": "Delete Prompt"
      }
    ],
    "submenus": [
      {
        "id": "ack.moveTo",
        "label": "Move To..."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ack.switchProfile",
          "when": "view == ack.toolTree",
          "group": "navigation"
        },
        {
          "command": "ack.switchAgent",
          "when": "view == ack.toolTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ack.toggleTool",
          "when": "view == ack.toolTree && viewItem =~ /^tool:/ && viewItem =~ /:toggleable:/ && viewItem !~ /^tool:custom_prompt:/ && viewItem =~ /:(?:user|project|local)$/",
          "group": "inline"
        },
        {
          "command": "ack.installTool",
          "when": "view == ack.toolTree && (viewItem == group:skill || viewItem == group:command)",
          "group": "inline"
        },
        {
          "command": "ack.toggleTool",
          "when": "view == ack.toolTree && viewItem =~ /^tool:/ && viewItem =~ /:toggleable:/ && viewItem !~ /^tool:custom_prompt:/ && viewItem =~ /:(?:user|project|local)$/",
          "group": "1_toggle"
        },
        {
          "submenu": "ack.moveTo",
          "when": "view == ack.toolTree && viewItem =~ /^tool:/ && viewItem =~ /:movable:/ && viewItem =~ /:(?:user|project)$/",
          "group": "2_scope"
        },
        {
          "command": "ack.deleteTool",
          "when": "view == ack.toolTree && viewItem =~ /^tool:/ && viewItem !~ /^tool:custom_prompt:/ && viewItem =~ /:(?:user|project|local)$/",
          "group": "3_danger"
        },
        {
          "command": "ack.installTool",
          "when": "view == ack.toolTree && (viewItem == group:skill || viewItem == group:command)",
          "group": "1_install"
        },
        {
          "command": "ack.addMcpServer",
          "when": "view == ack.toolTree && viewItem == group:mcp_server && ack.activeAdapterId == codex",
          "group": "inline"
        },
        {
          "command": "ack.addMcpServer",
          "when": "view == ack.toolTree && viewItem == group:mcp_server && ack.activeAdapterId == codex",
          "group": "2_codex"
        },
        {
          "command": "ack.toggleMcpTool",
          "when": "view == ack.toolTree && viewItem =~ /^subtool:mcp-tool:/ && ack.activeAdapterId == codex",
          "group": "inline"
        },
        {
          "command": "ack.addEnvVar",
          "when": "view == ack.toolTree && viewItem =~ /^tool:mcp_server:/ && viewItem =~ /:(?:user|project)$/ && ack.activeAdapterId == codex",
          "group": "2_envvar"
        },
        {
          "command": "ack.editEnvVar",
          "when": "view == ack.toolTree && viewItem == subtool:env-var && ack.activeAdapterId == codex",
          "group": "inline"
        },
        {
          "command": "ack.revealEnvVar",
          "when": "view == ack.toolTree && viewItem == subtool:env-var",
          "group": "1_envvar"
        },
        {
          "command": "ack.removeEnvVar",
          "when": "view == ack.toolTree && viewItem == subtool:env-var && ack.activeAdapterId == codex",
          "group": "3_envvar"
        },
        {
          "command": "ack.installPromptFromFile",
          "when": "view == ack.toolTree && viewItem == group:custom_prompt && ack.activeAdapterId == codex",
          "group": "inline"
        },
        {
          "command": "ack.installPromptFromFile",
          "when": "view == ack.toolTree && viewItem == group:custom_prompt && ack.activeAdapterId == codex",
          "group": "1_install"
        },
        {
          "command": "ack.installInstructionFromFile",
          "when": "view == ack.toolTree && viewItem == group:custom_prompt && ack.activeAdapterId == copilot",
          "group": "inline"
        },
        {
          "command": "ack.installInstructionFromFile",
          "when": "view == ack.toolTree && viewItem == group:custom_prompt && ack.activeAdapterId == copilot",
          "group": "1_install"
        },
        {
          "command": "ack.deletePrompt",
          "when": "view == ack.toolTree && viewItem =~ /^tool:custom_prompt:/",
          "group": "3_danger"
        }
      ],
      "ack.moveTo": [
        {
          "command": "ack.moveToolToUser",
          "when": "viewItem =~ /:movable:/ && viewItem =~ /:project$/"
        },
        {
          "command": "ack.moveToolToProject",
          "when": "viewItem =~ /:movable:/ && viewItem =~ /:user$/"
        }
      ]
    },
    "configuration": {
      "title": "ACK - Agent Config Keeper",
      "properties": {
        "ack.showChangeNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when agent config files change externally"
        },
        "ack.skipDeleteConfirmation": {
          "type": "boolean",
          "default": false,
          "description": "Skip confirmation dialog when deleting tools"
        },
        "ack.autoActivateWorkspaceProfiles": {
          "type": "boolean",
          "default": true,
          "description": "Automatically activate the associated profile when opening a workspace"
        }
      }
    },
    "colors": [
      {
        "id": "ack.enabledIcon",
        "description": "Icon color for enabled tools",
        "defaults": {
          "dark": "#89d185",
          "light": "#388a34",
          "highContrast": "#89d185",
          "highContrastLight": "#388a34"
        }
      },
      {
        "id": "ack.disabledIcon",
        "description": "Icon color for disabled tools",
        "defaults": {
          "dark": "#848484",
          "light": "#848484",
          "highContrast": "#848484",
          "highContrastLight": "#848484"
        }
      },
      {
        "id": "ack.errorIcon",
        "description": "Icon color for tools with errors",
        "defaults": {
          "dark": "#f14c4c",
          "light": "#e51400",
          "highContrast": "#f14c4c",
          "highContrastLight": "#e51400"
        }
      }
    ]
  },
  "scripts": {
    "compile:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --main-fields=module,main",
    "compile:webview": "node esbuild.webview.mjs",
    "compile": "npm run compile:ext && npm run compile:webview",
    "watch:ext": "npm run compile:ext -- --watch",
    "watch:webview": "node esbuild.webview.mjs --watch",
    "watch": "npm-run-all --parallel watch:ext watch:webview check-types",
    "check-types": "npm-run-all --continue-on-error check-types:ext check-types:webview",
    "check-types:ext": "tsc --noEmit",
    "check-types:webview": "tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src/",
    "test:unit": "vitest run",
    "test:integration": "vscode-test",
    "dev": "npm-run-all --parallel watch check-types",
    "package": "npm run compile:ext -- --minify && node esbuild.webview.mjs --minify",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.4.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "smol-toml": "^1.6.0",
    "write-file-atomic": "^6.0",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0",
    "@types/node": "^22",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.105.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24",
    "eslint": "^9.0",
    "npm-run-all": "^4.1",
    "typescript": "^5.7",
    "typescript-eslint": "^8.0",
    "vitest": "^3.0"
  }
}
